<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://tools.getOrCreate/placeholder">

    <!-- Permisos del Sistema Obligatorios -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Permiso requerido para Android 13 (API 33) en adelante para mostrar NotificationHelper -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Ajustes para almacenamiento heredado en dispositivos antiguos (Pre-Scoped Storage) -->
    <uses-permission 
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Enlace con tu clase Application personalizada para activar Room y Canales -->
    <application
        android:name=".VibeTuneCore"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication"
        tools:targetApi="31">
        
        <!-- Actividad Principal: Configurada con SingleTop para reutilizar hilos de red -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.VibeTune.Translucent">
            
            <!-- Lanzador Normal desde el Cajón de Aplicaciones del teléfono -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 🚨 EL FILTRO CRÍTICO: Registra la app en el menú 'Compartir' de YouTube -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- Especificamos que solo nos interesa recibir texto plano (URLs) -->
                <data android:mimeType="text/plain" />
            </intent-filter>
            
        </activity>
    </application>

</manifest>