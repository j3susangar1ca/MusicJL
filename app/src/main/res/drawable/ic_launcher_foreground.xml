<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Outer Gloss Accent -->
    <path
        android:pathData="M54,22 A32,32 0 1,0 86,54 A32,32 0 0,0 54,22 Z"
        android:strokeWidth="1.5"
        android:strokeColor="#33FFFFFF"
        android:fillColor="#00000000" />
        
    <!-- Vinyl Groove -->
    <path
        android:pathData="M54,30 A24,24 0 1,0 78,54 A24,24 0 0,0 54,30 Z"
        android:strokeWidth="1"
        android:strokeColor="#22FFFFFF"
        android:fillColor="#00000000" />

    <!-- Vinyl Disc Body -->
    <path
        android:pathData="M54,12 A42,42 0 1,1 12,54 A42,42 0 0,1 54,12 Z"
        android:strokeWidth="3.5"
        android:strokeColor="#FF3B30"
        android:fillColor="#00000000" />
        
    <!-- Central Label / Glow Disc -->
    <path
        android:pathData="M54,38 A16,16 0 1,0 70,54 A16,16 0 0,0 54,38 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="70"
                android:endY="70"
                android:startX="38"
                android:startY="38"
                android:type="linear">
                <item
                    android:color="#FF007AFF"
                    android:offset="0.0" />
                <item
                    android:color="#FF00C7BE"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    
    <!-- Bold Download Arrow in Center -->
    <path
        android:pathData="M54,42 L54,66 M44,56 L54,66 L64,56"
        android:strokeWidth="4.5"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
        
</vector>
